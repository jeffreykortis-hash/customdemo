# Secrets — never commit
.env
.env.*
*.pem
/tmp/.sigma_token

# Upstream skill mirror (cloned on demand by scripts/refresh-vendor.sh)
vendor/

# Client discovery artifacts — screenshots, PDFs, call transcripts.
# Their property; PII-bearing. The derived brief.json is committable, these are not.
artifacts/

# OS / editor junk
.DS_Store
*.swp
.idea/
.vscode/

# Python
__pycache__/
*.pyc

# Local Netlify folder
.netlify

# Cached vendor bundles for plugins/_scaffold/test.js
plugins/_scaffold/.react.js
plugins/_scaffold/.sdk.js
